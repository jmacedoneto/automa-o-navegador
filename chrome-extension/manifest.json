{
  "manifest_version": 3,
  "name": "AutoPilot - Gravador de Automação",
  "version": "3.0",
  "description": "Grave qualquer ação no navegador e envie direto para o AutoPilot",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoPilot Gravador"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
